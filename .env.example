# Names only. Set the values on the Vercel project "cockpit" (Settings → Environment Variables), never here.

# Operator login (same scheme as the Parksun admin)
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Hourly snapshot job (day 4)
CRON_SECRET=
COCKPIT_BLOB_READ_WRITE_TOKEN=

# Portail DPE: Supabase project mondpe (read through the admin_* SQL functions)
MONDPE_SUPABASE_URL=
MONDPE_SUPABASE_SERVICE_KEY=

# Blob stores of the other products. Vercel Blob has no read-only token: these are copies of
# each product's BLOB_READ_WRITE_TOKEN, and the cockpit code only ever calls list() and get().
PARKSUN_BLOB_TOKEN=
TERTIAIRE_BLOB_TOKEN=
DPEIMMEUBLE_BLOB_TOKEN=

# Operations and governance (read-only scopes)
VERCEL_API_TOKEN=
RESEND_API_KEY=
GITHUB_READ_TOKEN=
